--- /dev/null
+++ v1.1/web_rf_settings.h
@@ -0,0 +1,14 @@
+#pragma once
+
+#include "settings.h"
+
+static String makeRfFrequencySelect(const AppConfig &cfg) {
+  String page = F("<label>受信周波数<select name='rxfreq' style='width:100%;padding:8px;font-size:16px'>");
+  page += F("<option value='144.6600'");
+  if (cfg.rxFrequency == "144.6600") page += F(" selected");
+  page += F(">144.660 MHz（初期値）</option><option value='144.6400'");
+  if (cfg.rxFrequency == "144.6400") page += F(" selected");
+  page += F(">144.640 MHz</option></select></label>");
+  page += F("<p class='small'>復調方式はどちらの周波数でも1200bps AFSKです。国内では一般に144.660MHzが1200bps、144.640MHzが9600bps用です。本機は9600bpsの復調には対応していません。変更はSave &amp; Reboot後に反映します。</p>");
+  return page;
+}
